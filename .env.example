NODE_ENV=local
PORT=9090
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=bbrain

JWT_SECRET=local-secret
JWT_EXPIRES_IN=7d
PASSWORD_RESET_CODE_TTL_MINUTES=15
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_SWEEP_INTERVAL_MS=3600000
CONVERSATION_FINGERPRINT_SECRET=replace-with-an-independent-random-secret
CONVERSATION_STATE_TTL_HOURS=24
CONVERSATION_RECENT_MESSAGE_LIMIT=6
CONVERSATION_EXCHANGE_LEDGER_TTL_HOURS=24

EMAIL_PROVIDER=log
EMAIL_FROM=
EMAIL_FROM_NAME=BBrain
RESEND_API_KEY=

OPENAI_API_KEY=
