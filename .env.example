OPENAI_MODEL_REASONING=gpt-5.4
OPENAI_TIMEOUT_MS=30000

AI_PROVIDER=gemini
AI_EXTRACTION_MIN_CONFIDENCE=0.85
AI_MAX_RETRIES=1

GEMINI_API_KEY=
